{
  "name": "@enfect/opencode",
  "version": "0.8.0",
  "description": "Effect v4 guidance, skills, and post-write pattern checks for OpenCode",
  "keywords": [
    "effect",
    "effect-ts",
    "opencode",
    "opencode-plugin",
    "typescript"
  ],
  "homepage": "https://github.com/mpsuesser/enfect/tree/main/packages/opencode#readme",
  "bugs": {
    "url": "https://github.com/mpsuesser/enfect/issues"
  },
  "license": "MIT",
  "author": "Marc Suesser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpsuesser/enfect.git",
    "directory": "packages/opencode"
  },
  "files": [
    "dist",
    "docs",
    "guidance",
    "patterns",
    "skills"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --external @ast-grep/napi --external @opencode/plugin --outfile dist/index.js && bun ../core/scripts/stage-assets.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.3",
    "@opencode/plugin": "2.0.8"
  },
  "devDependencies": {
    "@enfect/core": "workspace:*"
  }
}
