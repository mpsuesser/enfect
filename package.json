{
  "name": "enfect",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/ai-openrouter": "4.0.6",
      "@effect/ai-typesafe": "4.0.6",
      "@effect/platform-bun": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/platform-node-shared": "4.0.6",
      "@effect/vitest": "4.0.6",
      "effect": "4.0.6"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "test": "bun test && bun run --filter @enfect/oxlint test",
    "typecheck": "tsgo",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.11.0",
    "@types/bun": "^1.4.4",
    "@typescript/native-preview": "^7.0.0-dev.20260523.1",
    "oxfmt": "^0.75.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
