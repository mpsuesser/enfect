{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "opencode-effect-enforcer",
  "version": "0.5.0",
  "description": "OpenCode V2 and Claude Code plugin for Effect v4 skills, guidance, and pattern enforcement",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "claude-code-plugin",
    "effect",
    "effect-ts"
  ],
  "homepage": "https://github.com/mpsuesser/opencode-effect-enforcer#readme",
  "bugs": {
    "url": "https://github.com/mpsuesser/opencode-effect-enforcer/issues"
  },
  "license": "MIT",
  "author": "Marc Suesser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpsuesser/opencode-effect-enforcer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": "./src/opencode/index.ts",
  "files": [
    "src",
    "dist",
    "hooks",
    ".claude-plugin",
    "skills",
    "guidance",
    "patterns",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/claude/hook.ts --target=node --format=esm --external @ast-grep/napi --outfile dist/claude-hook.mjs",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint -c oxlintrc.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "prepublishOnly": "bun run build && bun run check && bun run test"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.3",
    "@opencode/plugin": "2.0.8",
    "diff": "^9.0.0",
    "effect": "4.0.6",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@effect/ai-openrouter": "4.0.6",
    "@effect/ai-typesafe": "4.0.6",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "@types/bun": "^1.3.0",
    "@types/diff": "^8.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/picomatch": "^4.0.2",
    "dprint": "^0.50.2",
    "oxlint": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.14"
}
