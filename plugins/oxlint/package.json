{
  "name": "@enfect/oxlint",
  "version": "0.8.0",
  "description": "Oxlint plugin enforcing Effect-first development conventions",
  "keywords": [
    "effect",
    "eslint",
    "lint",
    "linter",
    "oxc",
    "oxlint",
    "oxlint-plugin",
    "oxlintplugin",
    "plugin",
    "rules",
    "typescript"
  ],
  "homepage": "https://github.com/mpsuesser/enfect/tree/main/plugins/oxlint#readme",
  "bugs": {
    "url": "https://github.com/mpsuesser/enfect/issues"
  },
  "license": "MIT",
  "author": "Marc Suesser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpsuesser/enfect.git",
    "directory": "plugins/oxlint"
  },
  "files": [
    "dist",
    "licenses",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --packages=external --outdir dist && tsgo -p tsconfig.build.json && mv dist/types/index.d.ts dist && rm -rf dist/types",
    "prepack": "bun run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.85.0",
    "effect": "catalog:",
    "effect-oxlint": "^0.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "5.0.1"
  }
}
