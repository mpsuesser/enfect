{
  "name": "@enfect/codex",
  "version": "0.9.0",
  "description": "Effect v4 guidance, skills, and advisory post-write pattern checks for Codex CLI",
  "keywords": [
    "codex",
    "codex-plugin",
    "effect",
    "effect-ts",
    "typescript"
  ],
  "homepage": "https://github.com/mpsuesser/enfect/tree/main/plugins/codex#readme",
  "bugs": {
    "url": "https://github.com/mpsuesser/enfect/issues"
  },
  "license": "MIT",
  "author": "Marc Suesser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpsuesser/enfect.git",
    "directory": "plugins/codex"
  },
  "files": [
    ".codex-plugin",
    "hooks",
    "dist",
    "commands",
    "docs",
    "guidance",
    "patterns",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/hook.ts --target=node --format=esm --external @ast-grep/napi --outfile dist/hook.mjs && bun ../../scripts/stage-catalogs.ts && bun src/stage.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.3"
  },
  "devDependencies": {
    "@enfect/commands": "workspace:*",
    "@enfect/core": "workspace:*",
    "@enfect/guidance": "workspace:*",
    "@enfect/patterns": "workspace:*",
    "@enfect/skills": "workspace:*"
  }
}
