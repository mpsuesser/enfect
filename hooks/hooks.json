          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.mjs",
              "session-start",
              "4"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
