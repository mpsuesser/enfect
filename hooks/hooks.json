{
  "description": "Inject Effect guidance at session and subagent start and review Effect patterns after file writes",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.mjs",
              "session-start",
              "1"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.mjs",
              "session-start",
              "2"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
